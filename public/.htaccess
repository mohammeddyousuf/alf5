<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Proxy product images for social crawlers (strips X-Robots-Tag)
  RewriteRule ^img-proxy/(.+)$ /prerender.php?img_proxy=$1 [L,QSA]

  # Route social media crawlers through PHP prerender for rich link previews
  RewriteCond %{HTTP_USER_AGENT} (WhatsApp|facebookexternalhit|Facebot|Twitterbot|Pinterest|LinkedInBot|Slackbot|TelegramBot|Discordbot) [NC]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^(.*)$ /prerender.php [L]

  # Normal SPA routing
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME} !-l
  RewriteRule . /index.html [L]
</IfModule>
